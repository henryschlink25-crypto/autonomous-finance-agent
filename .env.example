# ============================================================================
# AUTONOMOUS FINANCE AGENT - 1.000 € SMART-LEVERAGE & FAST-MOMENTUM (.env)
# ============================================================================

# 1. KI-Modell (Optional - Adaptive Quant-Engine ist integriert)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Ausführungs-Modus: "LOCAL_PAPER" (Standard), "ALPACA_PAPER", "CCXT_SANDBOX"
EXECUTION_MODE=LOCAL_PAPER

# 3. Alpaca Markets API (Für Aktien, 3x ETFs & Krypto - https://alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=True

# 4. CCXT Crypto Exchange (z.B. binance, coinbase, kraken)
CCXT_EXCHANGE_ID=binance
CCXT_API_KEY=
CCXT_SECRET_KEY=
CCXT_SANDBOX=True

# 5. 1.000 € Smart-Leverage & High-Velocity Risiko-Parameter
INITIAL_CAPITAL_USD=1000.0
SMART_LEVERAGE_MAX=2.0             # Bis 2.0x Margin-Hebel bei Grüner Makro-Ampel (3x ETFs TQQQ/SOXL/SQQQ haben 3x bereits integriert)
MAX_RISK_PER_TRADE_PCT=0.025       # Max 2.5% Konto-Risiko (25 €) pro Trade über engen ATR-Stop-Loss
MAX_POSITION_WEIGHT_PCT=0.30       # Fokus auf Top-3-Positionen (je bis zu 300 € Margin-Einsatz)
MAX_CLUSTER_WEIGHT_PCT=0.60        # Max 60% Margin in einem Sektor-Cluster
MIN_CASH_RESERVE_PCT=0.10          # Mind. 10% (100 €) eiserne Cash-Reserve
MAX_DAILY_DRAWDOWN_PCT=0.05        # Circuit Breaker bei >5% Tagesverlust
MIN_SIGNAL_CONFIDENCE=0.68         # Mindest-Konfidenz (68%)
MIN_RISK_REWARD_RATIO=1.6          # Mindest Chance-Risiko-Verhältnis
MAX_STALE_HOLDING_DAYS=5           # Schnelle 5-Tage-Rotation: Schließt eingeschlafene Trades nach 5 Tagen
